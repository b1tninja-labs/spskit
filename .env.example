# Copy to .env beside this file. .env is gitignored. Leave every secret empty in the example.
# The password is read from the environment and is not sent until the sign-in step that
# carries it has been written from a captured request. A verification code is typed at the
# prompt when the sign-in host asks for one, and it is not written into .env.

TDS_USERNAME=
TDS_PASSWORD=

# Techline Connect gateway and the ACDelco TDS sign-in host.
TDS_GATEWAY=https://tlc-dmz-gateway.ext.gm.com
TDS_CIAM=https://gmb2bciamprod.ciamlogin.com

# Optional bearer from a session you already hold. Leave empty until one exists.
TDS_ACCESS_TOKEN=

# Where licensed modules are written. Absolute path, outside this repository.
SPS_DOWNLOAD_DIR=D:/data/spskit
