# Copy to .env beside this file. .env is gitignored. Leave every secret empty in the example.
# `spskit login` posts passwd from TDS_NEW_PASSWORD when that is set, otherwise from TDS_PASSWORD.
# The email code is typed at the prompt and is not written here. TDS_CODE_VERIFIER is the PKCE
# verifier for a redirect you exchange with `spskit token`. Leave it empty in this example.
# TDS_CLIENT_ID and TDS_TENANT are the public sign-in directory, not secrets.

TDS_USERNAME=
TDS_PASSWORD=
TDS_NEW_PASSWORD=
TDS_ACCESS_TOKEN=
TDS_CODE_VERIFIER=

# Absolute path for the session file. Empty means SPS_DOWNLOAD_DIR/session.json, outside this
# repository. `spskit login` writes the email challenge there. `spskit code` reads it and, once
# the sign-in finishes, the file keeps the access token. `spskit session` stores an access token
# you already hold. The verification code is not written.
TDS_TOKEN_FILE=

# Techline Connect gateway, the sign-in host, and the TDS API.
TDS_GATEWAY=https://tlc-dmz-gateway.ext.gm.com
TDS_CIAM=https://gmb2bciamprod.ciamlogin.com
TDS_BACKEND=https://backend.acdelcotds.com
TDS_REDIRECT_URI=https://www.acdelcotds.com
TDS_CLIENT_ID=f5ad86b7-efd9-4305-b9c0-2f880adf3195
TDS_TENANT=450fd55c-b136-4d90-9e9f-a59b07772fab
TDS_ZONE=America/Los_Angeles

# Where licensed modules are written. Absolute path, outside this repository.
SPS_DOWNLOAD_DIR=D:/data/spskit
